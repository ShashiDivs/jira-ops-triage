# --- Postgres (pgvector) ---
POSTGRES_USER=ops_triage
POSTGRES_PASSWORD=ops_triage
POSTGRES_DB=ops_triage
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ops_triage:ops_triage@postgres:5432/ops_triage

# --- OpenAI (stopgap while the Azure subscription is disabled) ---
# Set this and it's used INSTEAD of Azure below (checked first). Remove it to switch back to Azure.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Cheaper/faster model for the supervisor's trivial/fast-path (Model Routing). Optional —
# empty means the trivial path also uses OPENAI_CHAT_MODEL above.
OPENAI_CHAT_MODEL_FAST=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure AI Foundry ---
# Resource root only (the v1 API appends /openai/v1/ itself) — NOT the project endpoint
# (.../api/projects/<name>), which is for the azure-ai-projects SDK, not chat/embeddings calls.
# e.g. https://<resource-name>.services.ai.azure.com
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
# Deployment names as configured in Azure AI Foundry (not the base model name)
AZURE_CHAT_DEPLOYMENT=gpt-4o
# Cheaper/faster deployment for the supervisor's trivial/fast-path (Model Routing). Optional —
# empty means the trivial path also uses AZURE_CHAT_DEPLOYMENT above.
AZURE_CHAT_DEPLOYMENT_FAST=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIM=1536

# Leave both OPENAI_API_KEY and AZURE_AI_FOUNDRY_API_KEY blank to run fully offline on the
# keyword-heuristic fallback (no LLM calls, deterministic triage/routing) — same behavior as
# the reference README. Note: RAG search (embeddings) still requires one of the two providers.

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

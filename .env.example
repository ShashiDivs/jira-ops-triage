# --- Postgres (pgvector) ---
POSTGRES_USER=ops_triage
POSTGRES_PASSWORD=ops_triage
POSTGRES_DB=ops_triage
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ops_triage:ops_triage@postgres:5432/ops_triage

# --- OpenAI (stopgap while the Azure subscription is disabled) ---
# Set this and it's used INSTEAD of Azure below (checked first). Remove it to switch back to Azure.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Cheaper/faster model for the supervisor's trivial/fast-path (Model Routing). Optional —
# empty means the trivial path also uses OPENAI_CHAT_MODEL above.
OPENAI_CHAT_MODEL_FAST=
# Stronger model reserved for the security triage path. Optional — empty means OPENAI_CHAT_MODEL.
OPENAI_CHAT_MODEL_SECURITY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure AI Foundry ---
# Resource root only (the v1 API appends /openai/v1/ itself) — NOT the project endpoint
# (.../api/projects/<name>), which is for the azure-ai-projects SDK, not chat/embeddings calls.
# e.g. https://<resource-name>.services.ai.azure.com
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
# Deployment names as configured in Azure AI Foundry (not the base model name)
AZURE_CHAT_DEPLOYMENT=gpt-4o
# Cheaper/faster deployment for the supervisor's trivial/fast-path (Model Routing). Optional —
# empty means the trivial path also uses AZURE_CHAT_DEPLOYMENT above.
AZURE_CHAT_DEPLOYMENT_FAST=
# Stronger/slower deployment reserved for the security triage path (e.g. a reasoning model).
# Optional — empty means the security path also uses AZURE_CHAT_DEPLOYMENT above.
AZURE_CHAT_DEPLOYMENT_SECURITY=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIM=1536

# Leave both OPENAI_API_KEY and AZURE_AI_FOUNDRY_API_KEY blank to run fully offline on the
# keyword-heuristic fallback (no LLM calls, deterministic triage/routing) — same behavior as
# the reference README. Note: RAG search (embeddings) still requires one of the two providers.

# --- Scheduled ticket generation (teaching extension) ---
# Off by default. When on, submits a random sample ticket through the normal pipeline every
# SCHEDULER_INTERVAL_SECONDS. Toggle live via POST /api/scheduler/pause and /resume.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300

# --- RAG retrieval ---
# Minimum similarity (1 - cosine_distance, 0-1) a result must have to be returned. Calibrated
# against this project's actual corpus + embedding model: genuine matches score ~0.35-0.6, an
# unrelated query scores well below that. 0.2 filters clear noise while still letting the LLM
# see (and weigh, via the score in the prompt) weak-but-real analogies. Set to 0.0 for the old
# permissive behavior (always return top-k regardless of quality).
RAG_MIN_SIMILARITY=0.2

# Semantic duplicate guard on promotion (RAG Phase 3.5). Much stricter than RAG_MIN_SIMILARITY
# above — this asks "is this essentially the same content already in the corpus," not "is this
# related." A near-verbatim resubmission of an existing historical ticket scores near 1.0;
# genuinely-different-but-related tickets score well below 0.95.
RAG_DUPLICATE_SIMILARITY_THRESHOLD=0.95

# --- Access control (Governance — RBAC for approvers) ---
# "name:role" pairs, comma-separated. Two roles: "approver" (ordinary tickets) and
# "security_approver" (required for tickets flagged security-related or payment/billing/PII-
# sensitive). Empty means every approval is refused (fail-closed) until this is configured.
APPROVER_ROLES=alice:approver,bob:security_approver

# --- RAG hybrid search (Phase 4) ---
# Blends vector similarity with Postgres full-text keyword rank so an exact component/service
# name match doesn't lose to a vaguely-similar-sounding but wrong document. Toggle off to
# compare against pure-vector ranking. RAG_HYBRID_VECTOR_WEIGHT is the vector's share of the
# blend (0-1); keyword rank gets the remainder.
RAG_HYBRID_SEARCH_ENABLED=true
RAG_HYBRID_VECTOR_WEIGHT=0.6

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

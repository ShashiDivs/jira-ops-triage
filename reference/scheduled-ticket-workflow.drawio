<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram name="Scheduled Ticket Workflow" id="scheduled-ticket-workflow">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Timer -->
        <mxCell id="timer" value="APScheduler timer&#10;(every N seconds)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Enabled? decision -->
        <mxCell id="enabled" value="Scheduler enabled?&#10;(SCHEDULER_ENABLED,&#10;/api/scheduler/pause|resume)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Skip -->
        <mxCell id="skip" value="Skip this tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="130" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Pick template -->
        <mxCell id="pick" value="Pick a template ticket&#10;(pool of ~15-20, spans&#10;all severities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="240" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Submit -->
        <mxCell id="submit" value="POST /api/tickets&#10;(same endpoint the UI uses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="340" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Existing pipeline (collapsed reference) -->
        <mxCell id="pipeline" value="Existing agent pipeline&#10;Intake -&gt; Guardrail -&gt; Supervisor -&gt;&#10;Triage -&gt; Routing -&gt; HITL Gate -&gt; Action&#10;(see agentic-pipeline.drawio — unchanged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- tickets table -->
        <mxCell id="ticketstable" value="tickets table&#10;(mock Jira log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="580" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- agent_runs -->
        <mxCell id="agentruns" value="agent_runs trace&#10;(same as any ticket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="580" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- historical_tickets (untouched) -->
        <mxCell id="historical" value="historical_tickets&#10;(RAG seed corpus)&#10;NOT touched automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="700" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Optional promotion -->
        <mxCell id="promote" value="optional manual action:&#10;promote a resolved ticket&#10;into the RAG corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="timer" target="enabled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="enabled" target="skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="back to waiting" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=0.5;exitY=0;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="skip" target="timer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="enabled" target="pick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="pick" target="submit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="submit" target="pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="pipeline" target="ticketstable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="pipeline" target="agentruns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="never automatic" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;strokeColor=#B85450;" edge="1" parent="1" source="ticketstable" target="historical">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="ticketstable" target="promote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="promote" target="historical">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

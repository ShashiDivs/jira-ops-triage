<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram name="RAG Retrieval Workflow" id="rag-retrieval-workflow">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Section A label -->
        <mxCell id="sectionA" value="Once, at app startup" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Startup check flow -->
        <mxCell id="startup" value="App startup" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="checkconsist" value="check_corpus_embedding_consistency()&#10;(Phase 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="modeldecision" value="stored embedding_model ==&#10;currently active model?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="warnlog" value="log warning&#10;(non-fatal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="235" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="continuesilent" value="continue silently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Section B label -->
        <mxCell id="sectionB" value="Every RAG search call" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Main retrieval flow -->
        <mxCell id="callstart" value="Graph node calls search_similar_tickets /&#10;search_runbooks(query, k, ticket_id, node_name)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="embed" value="embed_text(query)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="570" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pgvector" value="pgvector: ORDER BY&#10;cosine_distance LIMIT k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="650" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="computesim" value="similarity = 1 - distance&#10;(per row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="750" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="threshdecision" value="similarity &gt;=&#10;RAG_MIN_SIMILARITY?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="850" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="dropresult" value="drop this result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="865" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="keepresult" value="keep result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="970" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="tickeddecision" value="ticket_id provided?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="1040" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="skiplog" value="skip logging&#10;(e.g. seed.py, eval scripts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="1050" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="logrow" value="log row to retrieval_log&#10;(node_name, tool_name, query,&#10;result_count, top/avg similarity)&#10;— Phase 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="1150" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="returnresults" value="return results to caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="1260" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Edges: Section A -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="startup" target="checkconsist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="checkconsist" target="modeldecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="modeldecision" target="warnlog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="modeldecision" target="continuesilent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: Section B -->
        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="callstart" target="embed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="embed" target="pgvector">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="pgvector" target="computesim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="computesim" target="threshdecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="below threshold" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="threshdecision" target="dropresult">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="at/above threshold" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="threshdecision" target="keepresult">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="keepresult" target="tickeddecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="tickeddecision" target="skiplog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="tickeddecision" target="logrow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b10" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="logrow" target="returnresults">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b11" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.5;entryX=1;entryY=0;" edge="1" parent="1" source="skiplog" target="returnresults">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

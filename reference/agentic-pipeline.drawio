<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram name="Agentic Pipeline" id="agentic-pipeline">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Start -->
        <mxCell id="start" value="Ticket submitted" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Intake -->
        <mxCell id="intake" value="Intake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Guardrail (decision) -->
        <mxCell id="guardrail" value="Guardrail check&#10;(injection / empty input)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="180" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Blocked -->
        <mxCell id="blocked" value="Blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="200" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Supervisor (decision) -->
        <mxCell id="supervisor" value="Supervisor&#10;(routes by ticket content)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Triage: 3 specialist paths -->
        <mxCell id="triageSec" value="Triage: security path&#10;(specialist prompt, forces&#10;is_security_related=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="triageFast" value="Triage: trivial path&#10;(cheap model, no RAG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="440" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="triageGen" value="Triage: generic path&#10;(RAG-grounded, main model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="440" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Routing -->
        <mxCell id="routing" value="Routing&#10;(assign owning team)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="560" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- HITL Gate (decision) -->
        <mxCell id="hitl" value="HITL policy check&#10;(S1 / security / low&#10;confidence / payment or PII)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="650" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Auto-approved -->
        <mxCell id="auto" value="Auto-approved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="670" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Pending human review -->
        <mxCell id="pending" value="Pending human review&#10;(approve or reject)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="670" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Action -->
        <mxCell id="action" value="Action&#10;(write ticket + audit trail to Jira)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="800" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="Ticket logged" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="890" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="start" target="intake">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="intake" target="guardrail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="fails" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="guardrail" target="blocked">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="passes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="guardrail" target="supervisor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="security keywords" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="supervisor" target="triageSec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="cosmetic keywords" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="supervisor" target="triageFast">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="otherwise" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="supervisor" target="triageGen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="triageSec" target="routing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="triageFast" target="routing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="triageGen" target="routing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="routing" target="hitl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="none of those" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="hitl" target="auto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="S1, security, low conf,&#10;or payment/PII" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="hitl" target="pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="auto" target="action">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="pending" target="action">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="action" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="blocked" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

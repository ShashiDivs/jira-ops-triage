# Image for running an agent as a Foundry hosted agent (one image for all five roles).
#
#   OPS_ROLE selects what a container serves — set per agent version, not baked in:
#     orchestrator | triage-generic | triage-security | triage-trivial | routing
#
# Foundry requires linux/amd64 and serves the Invocations protocol on port 8088
# (GET /readiness is provided by the protocol library). Build it remotely in ACR so the
# architecture of your own machine doesn't matter:
#     az acr build --registry <acr> --platform linux/amd64 --image ops-triage-agent:<tag> \
#         --file Dockerfile.hosted .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Runtime dependencies only — NOT requirements.txt (that adds dspy/litellm, unused here).
COPY requirements-base.txt .
RUN pip install -r requirements-base.txt

COPY . .

# Precompile bytecode at build time so cold starts don't pay for it (slim base images ship almost
# none of the stdlib precompiled — the same step Microsoft's own hosted-agent samples take).
# PYTHONDONTWRITEBYTECODE blocks writes at runtime; it's cleared for this command only.
# Dependencies are best-effort so a stray unparsable vendored file can't fail the build; our own
# code is compiled strictly so a syntax error surfaces at build time, not at container start.
RUN PYTHONDONTWRITEBYTECODE= python -m compileall -q $(python -c "import sysconfig as s; print(s.get_paths()['stdlib'], s.get_paths()['purelib'])") || true; \
    PYTHONDONTWRITEBYTECODE= python -m compileall -q /app

EXPOSE 8088
CMD ["python", "-m", "hosted.server"]
